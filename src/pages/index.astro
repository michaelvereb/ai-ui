---
import '../styles/theme.css';
import Reasoning from '../components/ai-ui/Reasoning.astro';
import ThinkingBar from '../components/ai-ui/ThinkingBar.astro';
import Steps from '../components/ai-ui/Steps.astro';
import Tool from '../components/ai-ui/Tool.astro';
import ChainOfThought from '../components/ai-ui/ChainOfThought.astro';
import PromptInput from '../components/ai-ui/PromptInput.astro';
import ModelSelector from '../components/ai-ui/ModelSelector.astro';
import Suggestions from '../components/ai-ui/Suggestions.astro';
import Questions from '../components/ai-ui/Questions.astro';
import FeedbackBar from '../components/ai-ui/FeedbackBar.astro';
import Attachments from '../components/ai-ui/Attachments.astro';
import Citation from '../components/ai-ui/Citation.astro';
import Message from '../components/ai-ui/Message.astro';
import Thread from '../components/ai-ui/Thread.astro';
import Loader from '../components/ai-ui/Loader.astro';
import TextShimmer from '../components/ai-ui/TextShimmer.astro';
import Image from '../components/ai-ui/Image.astro';
import Toaster from '../components/ai-ui/Toaster.astro';
import ThemeCustomizer from '../components/ai-ui/ThemeCustomizer.astro';
import AnimateText from '../components/animations/AnimateText.astro';

const demoSteps = [
  { id: '1', title: 'Parse Query', status: 'completed' as const, summary: 'Input validated' },
  { id: '2', title: 'Execute Tool Call', status: 'running' as const, summary: 'Running diagnostics' },
  { id: '3', title: 'Synthesize Report', status: 'pending' as const, summary: 'Awaiting results' },
];

const demoThoughtNodes = [
  { title: 'Evaluate Input Parameters', detail: 'Schema validation passed', status: 'completed' as const },
  { title: 'Call Diagnostic Function', detail: 'Edge latency verified', status: 'active' as const },
  { title: 'Generate Output', detail: 'Markdown formatting', status: 'pending' as const },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@vereb/ai-ui — Component Test Workbench</title>
  <style>
    body {
      background-color: var(--bg, #ffffff);
      color: var(--text, #09090b);
      font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, sans-serif);
      margin: 0;
      padding: 48px 24px;
    }
    .workbench-layout {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 40px;
    }
    .wb-header {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    .wb-badge {
      display: inline-flex;
      padding: 4px 10px;
      background: color-mix(in srgb, var(--primary, #ED5F45) 12%, transparent);
      color: var(--primary, #ED5F45);
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 600;
    }
    .wb-title {
      font-size: 28px;
      font-weight: 700;
      margin: 0;
    }
    .wb-desc {
      font-size: 15px;
      color: var(--text-muted, #52525b);
      margin: 0;
    }
    .wb-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--primary, #ED5F45);
      text-decoration: none;
      font-weight: 500;
      font-size: 14px;
    }
    .wb-link:hover {
      text-decoration: underline;
    }
    .wb-section {
      display: flex;
      flex-direction: column;
      gap: 12px;
      border: 1px solid var(--border, #e4e4e7);
      border-radius: var(--radius, 14px);
      padding: 24px;
      background: var(--surface, #ffffff);
    }
    .wb-section-title {
      font-size: 16px;
      font-weight: 600;
      margin: 0;
      color: var(--text-muted, #71717a);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
  </style>
</head>
<body>
  <div class="workbench-layout">
    <header class="wb-header">
      <span class="wb-badge">Local Workbench</span>
      <h1 class="wb-title">@vereb/ai-ui Component Test Bench</h1>
      <p class="wb-desc">Modular Astro components for AI reasoning traces, streaming state, and agent UI.</p>
      <a href="https://www.michaelvereb.com/ai-ui" target="_blank" rel="noopener noreferrer" class="wb-link">
        <span>View Full Interactive Showcase & Live Customizer</span>
        <span>&rarr;</span>
      </a>
    </header>

    <section class="wb-section">
      <h2 class="wb-section-title">Thinking Bar</h2>
      <ThinkingBar autoCycle={true} isStreaming={true} />
    </section>

    <section class="wb-section">
      <h2 class="wb-section-title">Reasoning</h2>
      <Reasoning defaultOpen={true} />
    </section>

    <section class="wb-section">
      <h2 class="wb-section-title">Steps Pipeline</h2>
      <Steps steps={demoSteps} title="Agent Execution Pipeline" />
    </section>

    <section class="wb-section">
      <h2 class="wb-section-title">Tool Call</h2>
      <Tool name="verify_edge_security" status="completed" input={{ domain: 'example.com' }} output={{ status: 200, checks: 'PASS' }} />
    </section>

    <section class="wb-section">
      <h2 class="wb-section-title">Chain of Thought</h2>
      <ChainOfThought nodes={demoThoughtNodes} />
    </section>

    <section class="wb-section">
      <h2 class="wb-section-title">Prompt Input</h2>
      <PromptInput placeholder="Enter prompt..." submitLabel="Execute" />
    </section>

    <section class="wb-section">
      <h2 class="wb-section-title">Model Selector</h2>
      <ModelSelector selectedId="claude-3-5-sonnet" />
    </section>

    <section class="wb-section">
      <h2 class="wb-section-title">Loaders</h2>
      <div style="display: flex; gap: 20px; align-items: center;">
        <Loader variant="spinner" size="md" />
        <Loader variant="dots" size="md" />
        <Loader variant="pulse" size="md" />
      </div>
    </section>

    <section class="wb-section">
      <h2 class="wb-section-title">Text Shimmer</h2>
      <TextShimmer text="Autonomous agent synthesizing diagnostic report..." />
    </section>

    <section class="wb-section">
      <h2 class="wb-section-title">Text Animations (WAAPI)</h2>
      <AnimateText effect="soft-blur-in" text="Autonomous agent auditing edge security and schemas" />
    </section>
  </div>

  <Toaster />
  <ThemeCustomizer />
</body>
</html>
