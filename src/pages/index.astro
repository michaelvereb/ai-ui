  { id: 'anim-short-slide-down', effect: 'short-slide-down' as const, label: 'Short Slide Down', sample: sampleText },
  { id: 'anim-blur-out-up', effect: 'blur-out-up' as const, label: 'Blur Out Up', sample: sampleText },
  { id: 'anim-scale-down-fade', effect: 'scale-down-fade' as const, label: 'Scale Down Settle', sample: sampleText },
