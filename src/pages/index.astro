// 8. Michael Vereb /blog Rich Text Table Data (30-Point Site-Ready Specification Scorecard)
const scorecardItems = [
  { category: 'Edge Security', check: 'TLS 1.3 & Strict HSTS', spec: 'max-age=31536000; includeSubDomains', result: 'Verified (124ms TTFB)' },
  { category: 'Structured Data', check: 'RFC 8259 Single-Pass Escaping', spec: 'Zero double-escaped &amp; entities; clean Unicode hex', result: 'Passed (10 Schemas)' },
  { category: 'Agent Readiness', check: 'WebMCP Bridge & Tool Manifest', spec: 'navigator.modelContext + /.webmcp/bridge.js', result: 'Active (readOnlyHint)' },
  { category: 'AI Discovery', check: 'Dual llms.txt Discovery', spec: '<head> alternate link + visible footer anchor', result: '200 OK (Clean Index)' },
  { category: 'DNS Hygiene', check: 'Canonical WWW Redirection', spec: 'Strict 301 from apex to www subdomain', result: 'Enforced (Zero Loops)' },
  { category: 'Analytics', check: 'Cloudflare Zaraz Edge Execution', spec: 'Zero client-side GTM or gtag.js script overhead', result: 'Active (0ms CPU)' },
