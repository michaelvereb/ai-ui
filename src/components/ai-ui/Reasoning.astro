---
interface ReasoningStep {
  text: string;
  detail?: string;
}

interface Props {
  steps?: ReasoningStep[];
  title?: string;
  defaultOpen?: boolean;
  class?: string;
  id?: string;
}

const defaultSteps: ReasoningStep[] = [
  { text: 'Inspecting edge DNS, HTTP/2, and TLS 1.3 handshake', detail: 'HSTS max-age=31536000 verified. Edge TTFB: 124ms.' },
  { text: 'Validating RFC 8259 single-pass JSON-LD structured data', detail: 'Clean UTF-8 and Unicode hex escapes (zero double-escaped entities).' },
  { text: 'Probing autonomous agent reachability & WebMCP bridge', detail: 'Active bridge verified at /.webmcp/bridge.js (readOnlyHint: true).' },
  { text: 'Synthesizing 30-point Site-Ready remediation plan', detail: 'Zero-trust headers, schema graph, and crawler discovery aligned.' },
];

const {
  steps = defaultSteps,
  title = 'Reasoning',
  defaultOpen = true,
  class: className = '',
  id = `reasoning-${Math.random().toString(36).substring(2, 8)}`,
} = Astro.props;
---

<div
  class={`ai-reasoning ${className}`}
  data-reasoning-flow
  id={id}
  data-steps={JSON.stringify(steps)}
>
  <button
    type="button"
    class="ai-reasoning-trigger"
    aria-expanded={defaultOpen ? 'true' : 'false'}
    data-trigger
  >
    <div class="ai-reasoning-meta">
      <span class="ai-reasoning-status-icon" data-header-icon aria-hidden="true">
        <!-- Spinner while running, checkmark when complete -->
        <svg class="ai-icon-spinner animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
        </svg>
        <svg class="ai-icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </span>

      <span class="ai-reasoning-label" data-header-label>
        {title}
      </span>
    </div>

    <svg class="ai-reasoning-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div class="ai-reasoning-content" data-content hidden={!defaultOpen}>
    <div class="ai-reasoning-flow-list">
      {steps.map((step, index) => (
        <div
          class={`ai-flow-step ${index === 0 ? 'is-active' : 'is-pending'}`}
          data-step-index={index}
        >
          <div class="ai-flow-indicator">
            <span class="ai-flow-dot">
              <svg class="ai-flow-spinner animate-spin" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
              </svg>
              <svg class="ai-flow-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
          </div>

          <div class="ai-flow-text">
            <span class="ai-flow-step-title">{step.text}</span>
            {step.detail && <span class="ai-flow-step-detail">{step.detail}</span>}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .ai-reasoning {
    background: #ffffff;
    border: 1px solid var(--border, #e4e4e7);
    border-radius: 20px;
    overflow: hidden;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-ui, -0.02em);
    width: 100%;
    box-shadow: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  .ai-reasoning:hover {
    border-color: var(--border-strong, #d4d4d8);
  }

  .ai-reasoning-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 16px 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text, #09090b);
    text-align: left;
    min-height: 54px;
    font-family: inherit;
  }

  .ai-reasoning-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-reasoning-status-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--heat, #ED5F45);
  }

  .ai-reasoning-label {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text, #09090b);
  }

  .ai-reasoning-chevron {
    color: var(--text-subtle, #71717a);
    transition: transform 0.2s ease;
  }

  .ai-reasoning-trigger[aria-expanded="true"] .ai-reasoning-chevron {
    transform: rotate(180deg);
  }

  .ai-reasoning-content {
    border-top: 1px solid var(--border, #e4e4e7);
    background: #ffffff;
    padding: 20px 22px;
  }

  .ai-reasoning-content[hidden] {
    display: none;
  }

  .ai-reasoning-flow-list {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .ai-flow-step {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    position: relative;
    padding-bottom: 20px;
    width: 100%;
    transition: opacity 0.2s ease;
  }

  .ai-flow-step:last-child {
    padding-bottom: 0;
  }

  /* Keep indicator/checkmark at 100% solid opacity */
  .ai-flow-dot {
    opacity: 1;
  }

  /* Apply opacity strictly to the content div to the right */
  .ai-flow-step.is-completed .ai-flow-text {
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .ai-flow-step.is-completed:hover .ai-flow-text {
    opacity: 1;
  }

  .ai-flow-step.is-active .ai-flow-text {
    opacity: 1;
  }

  .ai-flow-step.is-pending .ai-flow-text {
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }

  .ai-flow-step.is-pending:hover .ai-flow-text {
    opacity: 0.85;
  }

  .ai-flow-indicator {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 22px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .ai-flow-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle, #fafafa);
    border: 1px solid var(--border, #e4e4e7);
    color: var(--text-subtle, #71717a);
    z-index: 2;
    transition: all 0.2s ease;
  }

  .ai-flow-spinner {
    display: none;
    color: var(--heat, #ED5F45);
  }

  .ai-flow-check {
    display: none;
    color: var(--heat, #ED5F45);
  }

  /* Active step: Spinner is visible */
  .ai-flow-step.is-active .ai-flow-dot {
    background: var(--heat-subtle, rgba(237, 95, 69, 0.08));
    border-color: var(--heat, #ED5F45);
  }

  .ai-flow-step.is-active .ai-flow-spinner {
    display: block;
  }

  /* Completed step: Checkmark is visible */
  .ai-flow-step.is-completed .ai-flow-dot {
    background: var(--heat-subtle, rgba(237, 95, 69, 0.12));
    border-color: var(--heat, #ED5F45);
    color: var(--heat, #ED5F45);
  }

  .ai-flow-step.is-completed .ai-flow-check {
    display: block;
  }

  .ai-flow-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex-grow: 1;
    min-width: 0;
  }

  .ai-flow-step-title {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text, #09090b);
    line-height: 1.4;
  }

  .ai-flow-step.is-pending .ai-flow-step-title {
    color: var(--text-muted, #52525b);
  }

  /* Subtext softer and lighter so it recedes gracefully */
  .ai-flow-step-detail {
    font-size: 13px;
    color: #a1a1aa;
    font-weight: 400;
    line-height: 1.45;
    white-space: normal;
    word-break: break-word;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }
</style>

<script>
  function initReasoningFlow() {
    document.querySelectorAll<HTMLElement>('[data-reasoning-flow]').forEach((el) => {
      const trigger = el.querySelector<HTMLButtonElement>('[data-trigger]');
      const content = el.querySelector<HTMLElement>('[data-content]');
      const headerSpinner = el.querySelector<SVGElement>('.ai-icon-spinner');
      const headerCheck = el.querySelector<SVGElement>('.ai-icon-check');
      const headerLabel = el.querySelector<HTMLElement>('[data-header-label]');
      const steps = el.querySelectorAll<HTMLElement>('.ai-flow-step');

      if (trigger && content) {
        trigger.addEventListener('click', () => {
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
          trigger.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
          if (isExpanded) {
            content.setAttribute('hidden', '');
          } else {
            content.removeAttribute('hidden');
          }
        });
      }

      if (steps.length === 0) return;

      // Sequential progression: step spins -> turns into checkmark -> moves down to next
      let currentIdx = 0;
      const stepInterval = 1400;

      function advanceStep() {
        if (currentIdx < steps.length) {
          const stepEl = steps[currentIdx];
          stepEl.classList.remove('is-active');
          stepEl.classList.add('is-completed');

          currentIdx++;

          if (currentIdx < steps.length) {
            const nextStep = steps[currentIdx];
            nextStep.classList.remove('is-pending');
            nextStep.classList.add('is-active');
            setTimeout(advanceStep, stepInterval);
          } else {
            // All steps completed: show header checkmark
            if (headerSpinner && headerCheck) {
              headerSpinner.style.display = 'none';
              headerCheck.style.display = 'inline-block';
            }
            if (headerLabel) {
              headerLabel.textContent = 'Reasoning Complete (4 steps verified)';
            }
          }
        }
      }

      setTimeout(advanceStep, stepInterval);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReasoningFlow);
  } else {
    initReasoningFlow();
  }
</script>
