---
interface Props {
  variant?: 'spinner' | 'progress' | 'dots' | 'pulse';
  size?: 'sm' | 'md' | 'lg';
  label?: string;
  progress?: number;
  class?: string;
}

const {
  variant = 'spinner',
  size = 'md',
  label = '',
  progress,
  class: className = '',
} = Astro.props;

const isDeterminate = typeof progress === 'number';
---

<div class={`ai-loader ai-loader-${variant} size-${size} ${className}`}>
  {variant === 'spinner' && (
    <div class="ai-loader-spinner-wrapper">
      <svg class="ai-spinner-svg animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <circle class="ai-spinner-track" cx="12" cy="12" r="10" stroke-width="3"></circle>
        <path class="ai-spinner-head" d="M12 2a10 10 0 0 1 10 10" stroke-width="3" stroke-linecap="round"></path>
      </svg>
      {label && <span class="ai-loader-label">{label}</span>}
    </div>
  )}

  {variant === 'progress' && (
    <div class="ai-loader-progress-wrapper">
      {label && (
        <div class="ai-progress-meta">
          <span class="ai-loader-label">{label}</span>
          {isDeterminate && <span class="ai-progress-pct">{Math.round(progress!)}%</span>}
        </div>
      )}
      <div class="ai-progress-track">
        {isDeterminate ? (
          <div class="ai-progress-fill" style={`width: ${Math.min(100, Math.max(0, progress!))}%`}></div>
        ) : (
          <div class="ai-progress-indeterminate"></div>
        )}
      </div>
    </div>
  )}

  {variant === 'dots' && (
    <div class="ai-loader-dots-wrapper">
      <div class="ai-dot-pulse">
        <span class="ai-dot"></span>
        <span class="ai-dot"></span>
        <span class="ai-dot"></span>
      </div>
      {label && <span class="ai-loader-label">{label}</span>}
    </div>
  )}

  {variant === 'pulse' && (
    <div class="ai-loader-pulse-wrapper">
      <span class="ai-pulse-ring"></span>
      <span class="ai-pulse-core"></span>
      {label && <span class="ai-loader-label">{label}</span>}
    </div>
  )}
</div>

<style>
  .ai-loader {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-ui, -0.15px);
  }

  .ai-loader-label {
    font-size: var(--text-xs, 12px);
    color: var(--text-muted, #71717a);
    font-weight: var(--font-medium, 500);
  }

  /* ── Spinner ── */
  .ai-loader-spinner-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ai-spinner-svg {
    stroke-linecap: round;
  }

  .size-sm .ai-spinner-svg { width: 14px; height: 14px; }
  .size-md .ai-spinner-svg { width: 18px; height: 18px; }
  .size-lg .ai-spinner-svg { width: 24px; height: 24px; }

  .ai-spinner-track {
    stroke: var(--border, #e4e4e7);
  }

  .ai-spinner-head {
    stroke: var(--heat, #ED5F45);
  }

  /* ── Progress Bar ── */
  .ai-loader-progress-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    min-width: 200px;
  }

  .ai-progress-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ai-progress-pct {
    font-family: var(--font-mono, monospace);
    font-size: 13px;
    color: var(--text-muted, #a1a1aa);
  }

  .ai-loader-progress {
    width: 100%;
  }

  .ai-progress-track {
    width: 100%;
    height: 6px;
    background: #e4e4e7;
    border-radius: var(--radius-pill, 9999px);
    overflow: hidden;
    position: relative;
    border: none;
  }

  .size-lg .ai-progress-track { height: 8px; }

  .ai-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #F18774 0%, var(--heat, #ED5F45) 100%);
    border-radius: var(--radius-pill, 9999px);
    transition: width 0.3s ease;
    box-shadow: 0 0 10px rgba(237, 95, 69, 0.4);
  }

  .ai-progress-indeterminate {
    height: 100%;
    width: 40%;
    background: linear-gradient(90deg, transparent 0%, var(--heat, #ED5F45) 50%, transparent 100%);
    border-radius: var(--radius-pill, 9999px);
    animation: ai-indeterminate-bar 1.5s infinite ease-in-out;
  }

  @keyframes ai-indeterminate-bar {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(350%); }
  }

  /* ── Dots ── */
  .ai-loader-dots-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ai-dot-pulse {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .ai-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--heat, #ED5F45);
    animation: ai-dot-bounce 1.4s infinite ease-in-out both;
  }

  .ai-dot:nth-child(1) { animation-delay: -0.32s; }
  .ai-dot:nth-child(2) { animation-delay: -0.16s; }

  @keyframes ai-dot-bounce {
    0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
    40%           { transform: scale(1); opacity: 1; }
  }

  /* ── Pulse ── */
  .ai-loader-pulse-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    position: relative;
  }

  .ai-pulse-core {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--heat, #ED5F45);
    display: inline-block;
  }

  .ai-pulse-ring {
    position: absolute;
    left: -2px;
    top: -2px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 2px solid var(--heat, #ED5F45);
    animation: ai-ring-pulse 1.8s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  @keyframes ai-ring-pulse {
    0%   { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(2.2); opacity: 0; }
  }
</style>
