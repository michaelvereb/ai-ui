---
interface SuggestionItem {
  label: string;
  description?: string;
}

interface Props {
  suggestions: SuggestionItem[];
  class?: string;
}

const {
  suggestions = [],
  class: className = '',
} = Astro.props;
---

<div class={`ai-suggestions-grid ${className}`} data-suggestions>
  {suggestions.map((item) => (
    <button type="button" class="ai-suggestion-card" data-suggestion-label={item.label}>
      <span class="ai-suggestion-label">{item.label}</span>
      {item.description && <span class="ai-suggestion-desc">{item.description}</span>}
    </button>
  ))}
</div>

<style>
  .ai-suggestions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
    width: 100%;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-ui, -0.02em);
  }

  .ai-suggestion-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 14px 18px;
    background: #ffffff;
    border: 1px solid var(--border, #e4e4e7);
    border-radius: var(--radius-md, 14px);
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }

  .ai-suggestion-card:hover {
    background: #fafafa;
    border-color: var(--heat, #ED5F45);
    transform: translateY(-1px);
  }

  .ai-suggestion-label {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text, #09090b);
  }

  .ai-suggestion-desc {
    font-size: 13px;
    color: var(--text-muted, #71717a);
    line-height: 1.35;
  }
</style>

<script>
  function initSuggestions() {
    document.querySelectorAll<HTMLElement>('[data-suggestions]').forEach((container) => {
      container.querySelectorAll<HTMLButtonElement>('[data-suggestion-label]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const label = btn.getAttribute('data-suggestion-label') || '';
          const promptInput = document.querySelector<HTMLTextAreaElement>('.ai-prompt-textarea');
          if (promptInput) {
            promptInput.value = label;
            promptInput.focus();
          }
          if (typeof (window as any).aiToast === 'function') {
            (window as any).aiToast({
              title: 'Suggestion loaded',
              description: label,
              variant: 'default',
            });
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSuggestions);
  } else {
    initSuggestions();
  }
</script>
