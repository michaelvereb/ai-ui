---
interface Props {
  class?: string;
  defaultOpen?: boolean;
}

const {
  class: className = '',
  defaultOpen = false,
} = Astro.props;
---

<!-- ─── Floating Trigger Button (Bottom Right) ─── -->
<div class="ai-customizer-trigger-wrapper">
  <button
    type="button"
    class="ai-customizer-trigger"
    id="ai-theme-trigger"
    aria-label="Open Theme Customizer"
    title="Customize Theme & Styles"
  >
    <svg class="ai-trigger-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
    </svg>
    <span class="ai-trigger-label">Customize</span>
    <span class="ai-trigger-dot" id="ai-active-color-dot" aria-hidden="true"></span>
  </button>
</div>

<!-- ─── Drawer Backdrop ─── -->
<div class="ai-customizer-backdrop" id="ai-customizer-backdrop" hidden></div>

<!-- ─── Sliding Settings Drawer Panel ─── -->
<aside
  class={`ai-customizer-drawer ${className}`}
  id="ai-customizer-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ai-customizer-title"
  hidden
>
  <!-- Drawer Header -->
  <div class="ai-drawer-header">
    <div class="ai-drawer-title-group">
      <div class="ai-title-row">
        <h3 class="ai-drawer-title" id="ai-customizer-title">Theme Customizer</h3>
        <span class="ai-badge-live">Live</span>
      </div>
      <p class="ai-drawer-subtitle">Live design & component token controls</p>
    </div>
    <div class="ai-drawer-header-actions">
      <button
        type="button"
        class="ai-btn-reset"
        id="ai-btn-reset-theme"
        title="Reset all settings to defaults"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
        </svg>
        <span>Reset</span>
      </button>
      <button
        type="button"
        class="ai-btn-close"
        id="ai-btn-close-drawer"
        aria-label="Close Theme Settings"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Drawer Scrollable Body -->
  <div class="ai-drawer-body">

    <!-- 1. Mode (Light / Dark) -->
    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label">Theme Mode</label>
        <span class="ai-setting-value" id="ai-active-mode-label">Light</span>
      </div>
      <div class="ai-pill-grid cols-2" id="ai-theme-mode-group">
        <button type="button" class="ai-mode-pill is-active" data-mode="light">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <span>Light</span>
        </button>
        <button type="button" class="ai-mode-pill" data-mode="dark">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span>Dark</span>
        </button>
      </div>
    </div>

    <!-- 2. Base Color (Primary / Accent) -->
    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label">Base Color</label>
        <span class="ai-setting-value" id="ai-active-color-name">Heat Orange</span>
      </div>
      <div class="ai-swatches-grid" id="ai-color-swatches">
        <!-- Heat Orange (Signature) -->
        <button
          type="button"
          class="ai-color-swatch is-active"
          data-color="#ED5F45"
          data-oklch="oklch(0.66 0.19 32.5)"
          data-name="Heat Orange"
          style="--swatch-color: #ED5F45;"
          title="Heat Orange (Default)"
        >
          <span class="ai-swatch-check">✓</span>
        </button>
        <!-- Zinc -->
        <button
          type="button"
          class="ai-color-swatch"
          data-color="#18181b"
          data-oklch="oklch(0.205 0 0)"
          data-name="Zinc"
          style="--swatch-color: #18181b;"
          title="Zinc"
        >
          <span class="ai-swatch-check">✓</span>
        </button>
        <!-- Blue -->
        <button
          type="button"
          class="ai-color-swatch"
          data-color="#2563eb"
          data-oklch="oklch(0.54 0.22 258.4)"
          data-name="Blue"
          style="--swatch-color: #2563eb;"
          title="Blue"
        >
          <span class="ai-swatch-check">✓</span>
        </button>
        <!-- Emerald -->
        <button
          type="button"
          class="ai-color-swatch"
          data-color="#059669"
          data-oklch="oklch(0.59 0.17 160.2)"
          data-name="Emerald"
          style="--swatch-color: #059669;"
          title="Emerald"
        >
          <span class="ai-swatch-check">✓</span>
        </button>
        <!-- Violet -->
        <button
          type="button"
          class="ai-color-swatch"
          data-color="#7c3aed"
          data-oklch="oklch(0.53 0.25 293.7)"
          data-name="Violet"
          style="--swatch-color: #7c3aed;"
          title="Violet"
        >
          <span class="ai-swatch-check">✓</span>
        </button>
        <!-- Rose -->
        <button
          type="button"
          class="ai-color-swatch"
          data-color="#e11d48"
          data-oklch="oklch(0.58 0.23 15.3)"
          data-name="Rose"
          style="--swatch-color: #e11d48;"
          title="Rose"
        >
          <span class="ai-swatch-check">✓</span>
        </button>
        <!-- Custom Color Picker -->
        <label class="ai-color-picker-label" title="Custom color picker">
          <input type="color" id="ai-custom-color-input" value="#ED5F45" />
          <span class="ai-color-picker-icon">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M2 12h20"></path>
            </svg>
          </span>
        </label>
      </div>
    </div>

    <!-- 3. Neutral (Background / Surface Tone) -->
    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label">Neutral (Background)</label>
        <span class="ai-setting-value" id="ai-active-neutral-name">Pure White</span>
      </div>
      <div class="ai-pill-grid cols-3" id="ai-neutral-group">
        <button type="button" class="ai-opt-pill is-active" data-neutral="white" data-bg="#ffffff" data-name="Pure White">White</button>
        <button type="button" class="ai-opt-pill" data-neutral="zinc" data-bg="#fafafa" data-name="Zinc">Zinc</button>
        <button type="button" class="ai-opt-pill" data-neutral="slate" data-bg="#f8fafc" data-name="Slate">Slate</button>
        <button type="button" class="ai-opt-pill" data-neutral="stone" data-bg="#fafaf9" data-name="Stone">Stone</button>
        <button type="button" class="ai-opt-pill" data-neutral="cream" data-bg="#faf8f5" data-name="Warm Cream">Cream</button>
        <label class="ai-neutral-custom-label" title="Custom background color">
          <input type="color" id="ai-custom-bg-input" value="#ffffff" />
          <span>Custom</span>
        </label>
      </div>
    </div>

    <!-- 4. Heading Font (Dropdown) -->
    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label" for="ai-heading-font-select">Heading Font</label>
        <span class="ai-setting-value" id="ai-active-heading-font-name">SF Pro</span>
      </div>
      <div class="ai-select-wrapper">
        <select id="ai-heading-font-select" class="ai-select-input">
          <option value="-apple-system, BlinkMacSystemFont, 'SF Pro', 'SF Pro Display', 'Segoe UI', sans-serif" selected>SF Pro (Apple System)</option>
          <option value="'Geist', -apple-system, sans-serif">Geist (Modern Geometric)</option>
          <option value="'Space Grotesk', sans-serif">Space Grotesk (Technical)</option>
          <option value="'DM Sans', sans-serif">DM Sans (Clean Sans)</option>
          <option value="'Outfit', sans-serif">Outfit (Editorial)</option>
          <option value="'Inter', sans-serif">Inter (UI Sans)</option>
          <option value="'Geist Mono', monospace">Geist Mono (Monospace)</option>
        </select>
      </div>
    </div>

    <!-- 5. Body Font (Dropdown) -->
    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label" for="ai-body-font-select">Body Font</label>
        <span class="ai-setting-value" id="ai-active-body-font-name">SF Pro</span>
      </div>
      <div class="ai-select-wrapper">
        <select id="ai-body-font-select" class="ai-select-input">
          <option value="-apple-system, BlinkMacSystemFont, 'SF Pro', 'SF Pro Text', 'Segoe UI', sans-serif" selected>SF Pro (Apple System)</option>
          <option value="'Geist', -apple-system, sans-serif">Geist (Modern Geometric)</option>
          <option value="'DM Sans', sans-serif">DM Sans (Clean Sans)</option>
          <option value="'Inter', sans-serif">Inter (UI Sans)</option>
          <option value="'Outfit', sans-serif">Outfit (Editorial)</option>
          <option value="'Space Grotesk', sans-serif">Space Grotesk (Technical)</option>
          <option value="'Geist Mono', monospace">Geist Mono (Monospace)</option>
        </select>
      </div>
    </div>

    <!-- 6. Border Radii / Roundness (Presets without px + Custom entry for px, %, rem) -->
    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label">Border Radius</label>
        <span class="ai-setting-value" id="ai-active-radius-name">0.75</span>
      </div>
      <!-- Presets (NO "px" text) -->
      <div class="ai-pill-grid cols-6" id="ai-radius-group">
        <button type="button" class="ai-opt-pill" data-radius="0px" data-rem="0" data-label="0">0</button>
        <button type="button" class="ai-opt-pill" data-radius="5px" data-rem="0.3rem" data-label="0.3">0.3</button>
        <button type="button" class="ai-opt-pill" data-radius="8px" data-rem="0.5rem" data-label="0.5">0.5</button>
        <button type="button" class="ai-opt-pill" data-radius="10px" data-rem="0.625rem" data-label="0.62">0.62</button>
        <button type="button" class="ai-opt-pill is-active" data-radius="14px" data-rem="0.75rem" data-label="0.75">0.75</button>
        <button type="button" class="ai-opt-pill" data-radius="20px" data-rem="1.0rem" data-label="1.0">1.0</button>
      </div>
      <!-- Custom Radius Entry (supports px, %, rem, or raw number) -->
      <div class="ai-custom-input-row">
        <input
          type="text"
          id="ai-custom-radius-input"
          class="ai-text-input"
          placeholder="Custom radius (e.g. 14px, 50%, 0.8rem)"
          value="14px"
        />
        <span class="ai-input-tip">Custom (px / % / rem)</span>
      </div>
    </div>

    <!-- 7. Icon Library (Dropdown) -->
    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label" for="ai-icon-select">Icon Library</label>
        <span class="ai-setting-value" id="ai-active-icon-name">Lucide</span>
      </div>
      <div class="ai-select-wrapper">
        <select id="ai-icon-select" class="ai-select-input">
          <option value="lucide" selected>Lucide (2.0 stroke)</option>
          <option value="minimal">Minimal Line (1.5 stroke)</option>
          <option value="tabler">Tabler Bold (2.4 stroke)</option>
          <option value="phosphor">Phosphor (Round)</option>
        </select>
      </div>
    </div>

    <!-- 8. Component Design Tweaks (Direct Levers) -->
    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label">Card Border Weight</label>
        <span class="ai-setting-value" id="ai-active-border-name">Hairline</span>
      </div>
      <div class="ai-pill-grid cols-4" id="ai-border-group">
        <button type="button" class="ai-opt-pill is-active" data-border="1px" data-name="Hairline">1px</button>
        <button type="button" class="ai-opt-pill" data-border="0px" data-name="Flush">0px</button>
        <button type="button" class="ai-opt-pill" data-border="1.5px" data-name="Defined">1.5px</button>
        <button type="button" class="ai-opt-pill" data-border="2px" data-name="Bold">2px</button>
      </div>
    </div>

    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label">Letter Spacing (Tracking)</label>
        <span class="ai-setting-value" id="ai-active-tracking-name">Tight</span>
      </div>
      <div class="ai-pill-grid cols-3" id="ai-tracking-group">
        <button type="button" class="ai-opt-pill is-active" data-tracking="-0.02em" data-name="Tight">-0.02em</button>
        <button type="button" class="ai-opt-pill" data-tracking="-0.035em" data-name="Compact">-0.035em</button>
        <button type="button" class="ai-opt-pill" data-tracking="0em" data-name="Normal">0em</button>
      </div>
    </div>

    <div class="ai-setting-section">
      <div class="ai-setting-label-row">
        <label class="ai-setting-label">Card Stage Padding</label>
        <span class="ai-setting-value" id="ai-active-padding-name">Default</span>
      </div>
      <div class="ai-pill-grid cols-3" id="ai-padding-group">
        <button type="button" class="ai-opt-pill" data-padding="28px 20px" data-name="Compact">Compact</button>
        <button type="button" class="ai-opt-pill is-active" data-padding="44px 28px" data-name="Default">Default</button>
        <button type="button" class="ai-opt-pill" data-padding="64px 36px" data-name="Spacious">Spacious</button>
      </div>
    </div>

    <!-- 9. Code Export Panel (OKLCH & Standard CSS) -->
    <div class="ai-setting-section ai-export-section">
      <div class="ai-export-top">
        <div class="ai-format-tabs" id="ai-code-format-tabs">
          <button type="button" class="ai-format-tab is-active" data-fmt="oklch">OKLCH</button>
          <button type="button" class="ai-format-tab" data-fmt="hex">CSS Hex</button>
        </div>
        <button
          type="button"
          class="ai-btn-copy-css"
          id="ai-btn-copy-css"
          title="Copy generated theme CSS variables to clipboard"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span id="ai-copy-css-label">Copy Code</span>
        </button>
      </div>

      <div class="ai-code-preview-wrap">
        <pre class="ai-code-pre"><code id="ai-css-code-output">/* Live theme CSS generated */</code></pre>
      </div>
    </div>

  </div>
</aside>

<style>
  /* ─── Floating Trigger Button (Bottom Right) ─── */
  .ai-customizer-trigger-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
  }

  .ai-customizer-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #09090b;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-pill, 9999px);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-customizer-trigger:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
    background: #18181b;
  }

  .ai-trigger-icon {
    transition: transform 0.3s ease;
  }

  .ai-customizer-trigger:hover .ai-trigger-icon {
    transform: rotate(45deg);
  }

  .ai-trigger-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--heat, #ED5F45);
    display: inline-block;
    box-shadow: 0 0 8px var(--heat, #ED5F45);
    transition: background-color 0.2s ease;
  }

  /* ─── Drawer Backdrop ─── */
  .ai-customizer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(2px);
    z-index: 998;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .ai-customizer-backdrop.is-visible {
    opacity: 1;
  }

  /* ─── Sliding Drawer Panel ─── */
  .ai-customizer-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 400px;
    background: #ffffff;
    color: #09090b;
    border-left: 1px solid var(--border, #e4e4e7);
    z-index: 999;
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.12);
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-ui, -0.02em);
    box-sizing: border-box;
  }

  .ai-customizer-drawer.is-open {
    transform: translateX(0);
  }

  :global(.dark) .ai-customizer-drawer,
  :global([data-theme="dark"]) .ai-customizer-drawer {
    background: #131316;
    color: #fafafa;
    border-left-color: #27272a;
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.55);
  }

  /* ─── Drawer Header ─── */
  .ai-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border, #e4e4e7);
    flex-shrink: 0;
  }

  :global(.dark) .ai-drawer-header,
  :global([data-theme="dark"]) .ai-drawer-header {
    border-bottom-color: #27272a;
  }

  .ai-drawer-title-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ai-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-drawer-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .ai-badge-live {
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    background: var(--heat-subtle, rgba(237, 95, 69, 0.1));
    color: var(--heat, #ED5F45);
    border: 1px solid rgba(237, 95, 69, 0.25);
    border-radius: 4px;
    line-height: 1;
  }

  .ai-drawer-subtitle {
    font-size: 12px;
    color: var(--text-muted, #71717a);
    margin: 0;
  }

  .ai-drawer-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-btn-reset {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 9px;
    background: transparent;
    border: 1px solid var(--border, #e4e4e7);
    border-radius: 6px;
    font-size: 11.5px;
    color: var(--text-muted, #71717a);
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .ai-btn-reset:hover {
    background: var(--bg-subtle, #f4f4f5);
    color: var(--text, #09090b);
  }

  .ai-btn-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--text-muted, #71717a);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .ai-btn-close:hover {
    background: var(--bg-subtle, #f4f4f5);
    color: var(--text, #09090b);
  }

  /* ─── Drawer Scrollable Body ─── */
  .ai-drawer-body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-setting-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-setting-label-row {
    display: flex;
    align-items: center;
