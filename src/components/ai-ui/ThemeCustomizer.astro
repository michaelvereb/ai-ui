  /* ─── Pill Grids ─── */
  .ai-pill-grid {
    display: grid;
    gap: 6px;
    width: 100%;
  }

  .ai-pill-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
  .ai-pill-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
  .ai-pill-grid.cols-4 { grid-template-columns: repeat(4, 1fr); }
  .ai-pill-grid.cols-6 { grid-template-columns: repeat(6, 1fr); }

  .ai-mode-pill,
  .ai-opt-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 7px 8px;
    background: var(--bg-subtle, #f4f4f5);
    border: 1px solid var(--border, #e4e4e7);
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-muted, #52525b);
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  :global(.dark) .ai-mode-pill,
  :global(.dark) .ai-opt-pill,
  :global([data-theme="dark"]) .ai-mode-pill,
  :global([data-theme="dark"]) .ai-opt-pill {
    background: #1c1c20;
    border-color: #2e2e34;
