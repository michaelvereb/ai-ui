    color: #ffffff;
  }

  .ai-btn-copy-css {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 11px;
    background: var(--text, #09090b);
    color: var(--bg, #ffffff);
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  :global(.dark) .ai-btn-copy-css,
  :global([data-theme="dark"]) .ai-btn-copy-css {
    background: #fafafa;
    color: #09090b;
  }

  .ai-btn-copy-css:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .ai-code-preview-wrap {
    background: #0d0d10;
    border: 1px solid #27272a;
    border-radius: 8px;
    overflow: hidden;
    max-height: 180px;
    position: relative;
  }

  .ai-code-pre {
    margin: 0;
    padding: 12px;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    line-height: 1.45;
    color: #e4e4e7;
    overflow-x: auto;
    overflow-y: auto;
    max-height: 180px;
    white-space: pre;
  }
</style>

<script>
  function initThemeCustomizer() {
    const trigger = document.getElementById('ai-theme-trigger');
    const drawer = document.getElementById('ai-customizer-drawer');
    const backdrop = document.getElementById('ai-customizer-backdrop');
    const closeBtn = document.getElementById('ai-btn-close-drawer');
    const resetBtn = document.getElementById('ai-btn-reset-theme');
    const copyCssBtn = document.getElementById('ai-btn-copy-css');
    const codeOutput = document.getElementById('ai-css-code-output');
    const activeColorDot = document.getElementById('ai-active-color-dot');
    const activeColorName = document.getElementById('ai-active-color-name');
    const activeNeutralName = document.getElementById('ai-active-neutral-name');
    const activeModeLabel = document.getElementById('ai-active-mode-label');
    const activeHeadingFontName = document.getElementById('ai-active-heading-font-name');
    const activeBodyFontName = document.getElementById('ai-active-body-font-name');
    const activeRadiusName = document.getElementById('ai-active-radius-name');
    const activeIconName = document.getElementById('ai-active-icon-name');
    const activeBorderName = document.getElementById('ai-active-border-name');
    const activeTrackingName = document.getElementById('ai-active-tracking-name');
    const activePaddingName = document.getElementById('ai-active-padding-name');

    const headingFontSelect = document.getElementById('ai-heading-font-select') as HTMLSelectElement;
    const bodyFontSelect = document.getElementById('ai-body-font-select') as HTMLSelectElement;
    const iconSelect = document.getElementById('ai-icon-select') as HTMLSelectElement;
    const customColorInput = document.getElementById('ai-custom-color-input') as HTMLInputElement;
    const customBgInput = document.getElementById('ai-custom-bg-input') as HTMLInputElement;
    const customRadiusInput = document.getElementById('ai-custom-radius-input') as HTMLInputElement;

    // State
    const defaultState = {
      mode: 'light',
      baseColor: '#ED5F45',
      baseColorOklch: 'oklch(0.66 0.19 32.5)',
      baseColorName: 'Heat Orange',
      neutral: 'white',
      neutralBg: '#ffffff',
      neutralName: 'Pure White',
      headingFont: "-apple-system, BlinkMacSystemFont, 'SF Pro', 'SF Pro Display', 'Segoe UI', sans-serif",
      headingFontName: 'SF Pro',
      bodyFont: "-apple-system, BlinkMacSystemFont, 'SF Pro', 'SF Pro Text', 'Segoe UI', sans-serif",
      bodyFontName: 'SF Pro',
      radius: '14px',
      radiusLabel: '0.75',
      icon: 'lucide',
      iconName: 'Lucide',
      borderWidth: '1px',
      borderName: 'Hairline',
      tracking: '-0.02em',
      trackingName: 'Tight',
      padding: '44px 28px',
      paddingName: 'Default',
      format: 'oklch',
    };

    let state = { ...defaultState };

    // Open / Close Drawer
    function openDrawer() {
      if (!drawer || !backdrop) return;
      drawer.removeAttribute('hidden');
      backdrop.removeAttribute('hidden');
      requestAnimationFrame(() => {
        drawer.classList.add('is-open');
        backdrop.classList.add('is-visible');
      });
    }

    function closeDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-visible');
      setTimeout(() => {
        drawer.setAttribute('hidden', '');
        backdrop.setAttribute('hidden', '');
      }, 320);
    }

    trigger?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    // Generate OKLCH or Standard CSS Variables Output
    function generateCssCode(): string {
      const isDark = state.mode === 'dark';

      if (state.format === 'oklch') {
        return `:root {
  --background: ${isDark ? 'oklch(0.145 0 0)' : 'oklch(1 0 0)'};
  --foreground: ${isDark ? 'oklch(0.985 0 0)' : 'oklch(0.145 0 0)'};
  --card: ${isDark ? 'oklch(0.205 0 0)' : 'oklch(1 0 0)'};
  --card-foreground: ${isDark ? 'oklch(0.985 0 0)' : 'oklch(0.145 0 0)'};
  --popover: ${isDark ? 'oklch(0.205 0 0)' : 'oklch(1 0 0)'};
  --popover-foreground: ${isDark ? 'oklch(0.985 0 0)' : 'oklch(0.145 0 0)'};
  --primary: ${state.baseColorOklch};
  --primary-foreground: oklch(0.985 0 0);
  --secondary: ${isDark ? 'oklch(0.269 0 0)' : 'oklch(0.97 0 0)'};
  --secondary-foreground: ${isDark ? 'oklch(0.985 0 0)' : 'oklch(0.205 0 0)'};
  --muted: ${isDark ? 'oklch(0.269 0 0)' : 'oklch(0.97 0 0)'};
  --muted-foreground: ${isDark ? 'oklch(0.708 0 0)' : 'oklch(0.556 0 0)'};
  --accent: ${state.baseColorOklch};
  --accent-foreground: oklch(0.985 0 0);
  --destructive: oklch(0.577 0.245 27.325);
  --border: ${isDark ? 'oklch(1 0 0 / 10%)' : 'oklch(0.922 0 0)'};
  --input: ${isDark ? 'oklch(1 0 0 / 15%)' : 'oklch(0.922 0 0)'};
  --ring: ${state.baseColorOklch};
  --radius: ${state.radius};
  --font-heading: ${state.headingFont};
  --font-body: ${state.bodyFont};
  --tracking-ui: ${state.tracking};
}

.dark {
  --background: oklch(0.145 0 0);
  --foreground: oklch(0.985 0 0);
  --card: oklch(0.205 0 0);
  --card-foreground: oklch(0.985 0 0);
  --primary: ${state.baseColorOklch};
  --primary-foreground: oklch(0.205 0 0);
  --border: oklch(1 0 0 / 10%);
  --ring: ${state.baseColorOklch};
}`;
      }

      // CSS Hex format
      return `:root {
  --theme-mode: ${state.mode};
  --primary: ${state.baseColor};
  --heat: ${state.baseColor};
  --accent: ${state.baseColor};
  --background: ${isDark ? '#09090b' : state.neutralBg};
  --surface: ${isDark ? '#131316' : '#ffffff'};
  --border: ${isDark ? '#27272a' : '#e4e4e7'};
  --border-width: ${state.borderWidth};
  --font-heading: ${state.headingFont};
  --font-sans: ${state.bodyFont};
  --radius: ${state.radius};
  --radius-card: ${state.radius};
  --tracking-ui: ${state.tracking};
}

.dark {
  --background: #09090b;
  --surface: #131316;
  --border: #27272a;
  --primary: ${state.baseColor};
}`;
    }

    // Apply active state dynamically to DOM
    function applyState() {
      const root = document.documentElement;
      const isDark = state.mode === 'dark';

      // 1. Theme Mode & Background
      if (isDark) {
        root.setAttribute('data-theme', 'dark');
        root.classList.add('dark');
        document.body.style.backgroundColor = '#09090b';
        root.style.setProperty('--bg', '#09090b');
        root.style.setProperty('--surface', '#131316');
      } else {
        root.removeAttribute('data-theme');
        root.classList.remove('dark');
        document.body.style.backgroundColor = state.neutralBg;
        root.style.setProperty('--bg', state.neutralBg);
        root.style.setProperty('--surface', '#ffffff');
      }
      if (activeModeLabel) activeModeLabel.textContent = isDark ? 'Dark' : 'Light';
      if (activeNeutralName) activeNeutralName.textContent = state.neutralName;

      // 2. Base Color & Heat variables
      root.style.setProperty('--heat', state.baseColor);
      root.style.setProperty('--primary', state.baseColor);
      root.style.setProperty('--accent', state.baseColor);
      root.style.setProperty('--ring', state.baseColor);
      root.style.setProperty('--heat-subtle', `${state.baseColor}18`);
      root.style.setProperty('--heat-gradient', `linear-gradient(180deg, ${state.baseColor} 0%, ${state.baseColor}dd 100%)`);
      root.style.setProperty('--btn-primary-bg', `linear-gradient(180deg, ${state.baseColor} 0%, ${state.baseColor}ee 100%)`);

      if (activeColorDot) activeColorDot.style.backgroundColor = state.baseColor;
      if (activeColorName) activeColorName.textContent = state.baseColorName;

      // 3. Fonts (SF Pro & Select options)
      root.style.setProperty('--font-heading', state.headingFont);
      document.querySelectorAll<HTMLElement>('h1, h2, h3, .section-title, .brand-name').forEach((el) => {
        el.style.fontFamily = state.headingFont;
      });
      if (activeHeadingFontName) activeHeadingFontName.textContent = state.headingFontName;

      root.style.setProperty('--font-sans', state.bodyFont);
      document.body.style.fontFamily = state.bodyFont;
      if (activeBodyFontName) activeBodyFontName.textContent = state.bodyFontName;

      // 4. Border Radius (Custom & Presets)
      root.style.setProperty('--radius', state.radius);
      root.style.setProperty('--radius-card', state.radius);
      root.style.setProperty('--radius-md', state.radius);
      document.querySelectorAll<HTMLElement>('.component-stage, .anim-list-item, .demo-card').forEach((el) => {
        el.style.borderRadius = state.radius;
      });
      if (activeRadiusName) activeRadiusName.textContent = state.radiusLabel;
      if (customRadiusInput && customRadiusInput.value !== state.radius) {
        customRadiusInput.value = state.radius;
      }

      // 5. Border Weight / Width
      root.style.setProperty('--border-width', state.borderWidth);
      document.querySelectorAll<HTMLElement>('.component-stage, .anim-list-item, .loader-thinking-pill').forEach((el) => {
        el.style.borderWidth = state.borderWidth;
      });
      if (activeBorderName) activeBorderName.textContent = state.borderName;

      // 6. Letter Spacing Tracking
      root.style.setProperty('--tracking-ui', state.tracking);
      document.body.style.letterSpacing = state.tracking;
      if (activeTrackingName) activeTrackingName.textContent = state.trackingName;

      // 7. Card Stage Padding Density
      document.querySelectorAll<HTMLElement>('.component-stage').forEach((el) => {
        el.style.padding = state.padding;
      });
      if (activePaddingName) activePaddingName.textContent = state.paddingName;

      // 8. Icon Library Stroke Width
      if (state.icon === 'minimal') {
        document.querySelectorAll<SVGElement>('svg:not(.ai-trigger-icon)').forEach((svg) => {
          svg.setAttribute('stroke-width', '1.5');
        });
      } else if (state.icon === 'tabler') {
        document.querySelectorAll<SVGElement>('svg:not(.ai-trigger-icon)').forEach((svg) => {
          svg.setAttribute('stroke-width', '2.4');
        });
      } else {
        document.querySelectorAll<SVGElement>('svg:not(.ai-trigger-icon)').forEach((svg) => {
          svg.setAttribute('stroke-width', '2.0');
        });
      }
      if (activeIconName) activeIconName.textContent = state.iconName;

      // 9. Update Code Preview
      if (codeOutput) {
        codeOutput.textContent = generateCssCode();
      }
    }

    // Bind Mode Buttons
    document.querySelectorAll<HTMLButtonElement>('#ai-theme-mode-group [data-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#ai-theme-mode-group [data-mode]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        state.mode = btn.getAttribute('data-mode') || 'light';
        applyState();
      });
    });

    // Bind Base Color Swatches
    document.querySelectorAll<HTMLButtonElement>('#ai-color-swatches .ai-color-swatch').forEach((swatch) => {
      swatch.addEventListener('click', () => {
        document.querySelectorAll('#ai-color-swatches .ai-color-swatch').forEach((s) => s.classList.remove('is-active'));
        swatch.classList.add('is-active');
        state.baseColor = swatch.getAttribute('data-color') || '#ED5F45';
        state.baseColorOklch = swatch.getAttribute('data-oklch') || 'oklch(0.66 0.19 32.5)';
        state.baseColorName = swatch.getAttribute('data-name') || 'Custom';
        applyState();
      });
    });

    // Custom Color Input
    customColorInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      document.querySelectorAll('#ai-color-swatches .ai-color-swatch').forEach((s) => s.classList.remove('is-active'));
      state.baseColor = val;
      state.baseColorOklch = `oklch(from ${val} l c h)`;
      state.baseColorName = val.toUpperCase();
      applyState();
    });

    // Bind Neutral Background Buttons
    document.querySelectorAll<HTMLButtonElement>('#ai-neutral-group [data-neutral]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#ai-neutral-group [data-neutral]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        state.neutral = btn.getAttribute('data-neutral') || 'white';
        state.neutralBg = btn.getAttribute('data-bg') || '#ffffff';
        state.neutralName = btn.getAttribute('data-name') || 'White';
        applyState();
      });
    });

    // Custom Neutral Background Input
    customBgInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      document.querySelectorAll('#ai-neutral-group [data-neutral]').forEach((b) => b.classList.remove('is-active'));
      state.neutral = 'custom';
      state.neutralBg = val;
      state.neutralName = val.toUpperCase();
      applyState();
    });

    // Heading Font Select (Dropdown)
    headingFontSelect?.addEventListener('change', () => {
      const val = headingFontSelect.value;
      const text = headingFontSelect.options[headingFontSelect.selectedIndex].text.split(' (')[0];
      state.headingFont = val;
      state.headingFontName = text;
      applyState();
    });

    // Body Font Select (Dropdown)
    bodyFontSelect?.addEventListener('change', () => {
      const val = bodyFontSelect.value;
      const text = bodyFontSelect.options[bodyFontSelect.selectedIndex].text.split(' (')[0];
      state.bodyFont = val;
      state.bodyFontName = text;
      applyState();
    });

    // Icon Select (Dropdown)
    iconSelect?.addEventListener('change', () => {
      const val = iconSelect.value;
      const text = iconSelect.options[iconSelect.selectedIndex].text.split(' (')[0];
      state.icon = val;
      state.iconName = text;
      applyState();
    });

    // Radius Preset Buttons (NO "px" shown)
    document.querySelectorAll<HTMLButtonElement>('#ai-radius-group [data-radius]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#ai-radius-group [data-radius]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const r = btn.getAttribute('data-radius') || '14px';
        state.radius = r;
        state.radiusLabel = btn.getAttribute('data-label') || r;
        applyState();
      });
    });

    // Custom Radius Text Input (allows px, %, rem, raw numbers)
    customRadiusInput?.addEventListener('input', () => {
      let val = customRadiusInput.value.trim();
      if (!val) return;
      // If user types just a number (e.g. 16), interpret as px
      if (/^\d+$/.test(val)) {
        val = `${val}px`;
      }
      document.querySelectorAll('#ai-radius-group [data-radius]').forEach((b) => b.classList.remove('is-active'));
      state.radius = val;
      state.radiusLabel = val;
      applyState();
    });

    // Card Border Width Buttons
    document.querySelectorAll<HTMLButtonElement>('#ai-border-group [data-border]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#ai-border-group [data-border]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        state.borderWidth = btn.getAttribute('data-border') || '1px';
        state.borderName = btn.getAttribute('data-name') || state.borderWidth;
        applyState();
      });
    });

    // Tracking Buttons
    document.querySelectorAll<HTMLButtonElement>('#ai-tracking-group [data-tracking]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#ai-tracking-group [data-tracking]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        state.tracking = btn.getAttribute('data-tracking') || '-0.02em';
        state.trackingName = btn.getAttribute('data-name') || state.tracking;
        applyState();
      });
    });

    // Card Stage Padding Buttons
    document.querySelectorAll<HTMLButtonElement>('#ai-padding-group [data-padding]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#ai-padding-group [data-padding]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        state.padding = btn.getAttribute('data-padding') || '44px 28px';
        state.paddingName = btn.getAttribute('data-name') || 'Default';
        applyState();
      });
    });

    // Code Format Tabs
    document.querySelectorAll<HTMLButtonElement>('#ai-code-format-tabs [data-fmt]').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('#ai-code-format-tabs [data-fmt]').forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        state.format = tab.getAttribute('data-fmt') || 'oklch';
        if (codeOutput) codeOutput.textContent = generateCssCode();
      });
    });

    // Reset Button
    resetBtn?.addEventListener('click', () => {
      state = { ...defaultState };

      // Reset controls
      document.querySelectorAll('#ai-theme-mode-group [data-mode]').forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-mode') === 'light');
      });
      document.querySelectorAll('#ai-color-swatches .ai-color-swatch').forEach((s) => {
        s.classList.toggle('is-active', s.getAttribute('data-color') === '#ED5F45');
      });
      document.querySelectorAll('#ai-neutral-group [data-neutral]').forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-neutral') === 'white');
      });
      document.querySelectorAll('#ai-radius-group [data-radius]').forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-label') === '0.75');
      });
      document.querySelectorAll('#ai-border-group [data-border]').forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-border') === '1px');
      });
      document.querySelectorAll('#ai-tracking-group [data-tracking]').forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-tracking') === '-0.02em');
      });
      document.querySelectorAll('#ai-padding-group [data-padding]').forEach((b) => {
        b.classList.toggle('is-active', b.getAttribute('data-name') === 'Default');
      });

      if (headingFontSelect) headingFontSelect.selectedIndex = 0;
      if (bodyFontSelect) bodyFontSelect.selectedIndex = 0;
      if (iconSelect) iconSelect.selectedIndex = 0;
      if (customRadiusInput) customRadiusInput.value = '14px';

      applyState();
      if (typeof (window as any).aiToast === 'function') {
        (window as any).aiToast('Theme reset to SF Pro & Michael Vereb defaults');
      }
    });

    // Copy Code Button — triggers window.aiToast per guidelines
    copyCssBtn?.addEventListener('click', () => {
      const code = generateCssCode();
      navigator.clipboard.writeText(code).then(() => {
        if (typeof (window as any).aiToast === 'function') {
          (window as any).aiToast('Theme CSS variables copied to clipboard');
        }
      });
    });

    // Initial render
    applyState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeCustomizer);
  } else {
    initThemeCustomizer();
  }
</script>
